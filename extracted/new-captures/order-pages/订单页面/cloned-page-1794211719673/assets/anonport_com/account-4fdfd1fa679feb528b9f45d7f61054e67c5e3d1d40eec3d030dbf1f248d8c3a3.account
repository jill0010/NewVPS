                                        <svg class="tu-amt-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 8.5l3 3 7-7"/></svg>
                  </button>
                                  <button type="button" class="tu-amt has-bonus" data-amt="1000" data-bonus="500.00">
                    <span class="tu-amt-val">$1,000</span>
                                          <span class="tu-amt-total">您将获得 $1,500</span>
                                        <svg class="tu-amt-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 8.5l3 3 7-7"/></svg>
                  </button>
