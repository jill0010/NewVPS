<script>
function toggleMob(){
  var m=document.getElementById('mobMenu'),b=document.getElementById('mobBtn');
  var open=m.classList.toggle('open');
  b.classList.toggle('open',open);
  b.setAttribute('aria-expanded',open?'true':'false');
  if(open) syncMobMenuTop();
  document.body.style.overflow=open?'hidden':'';
}

// Le bandeau promo est AU-DESSUS du header sticky et defile avec la page :
// le bas reel du header se promene donc entre 0 et (hauteur du bandeau).
// Or .mob-menu est position:fixed. L'ancrer sur var(--hh) seul le glisserait
// SOUS le header chaque fois que le bandeau est encore a l'ecran -- un menu
// dont les premiers liens sont caches derriere un en-tete opaque a l'air
// parfaitement normal sur une capture, et ne l'est pas du tout au doigt.
// On mesure donc le bord bas reel a l'ouverture. Le defilement est gele
// pendant que le menu est ouvert (body.overflow=hidden), la valeur ne peut
// donc pas se perimer ; seul un pivot d'ecran la change.
function syncMobMenuTop(){
  var hd=document.querySelector('.hd');
  if(!hd) return;
  var b=Math.max(0,Math.round(hd.getBoundingClientRect().bottom));
  document.documentElement.style.setProperty('--mob-menu-top',b+'px');
}
window.addEventListener('resize',function(){
  var m=document.getElementById('mobMenu');
  if(m&&m.classList.contains('open')) syncMobMenuTop();
});

// Language switcher: search, keyboard nav, outside-click close
(function(){
  var sw=document.getElementById('langSw');
  if(!sw) return;
  var btn=document.getElementById('langBtn');
  var menu=document.getElementById('langMenu');
  var search=document.getElementById('langSearch');
  var grid=document.getElementById('langGrid');
  var empty=document.getElementById('langEmpty');
  var opts=Array.prototype.slice.call(grid.querySelectorAll('.lang-opt'));
  var kbdIdx=-1;

  function visible(){return opts.filter(function(o){return !o.hidden;});}
  function clearKbd(){opts.forEach(function(o){o.classList.remove('kbd');});}
  function setKbd(i){
    clearKbd();
    var v=visible();
    if(!v.length){kbdIdx=-1;return;}
    kbdIdx=(i+v.length)%v.length;
    v[kbdIdx].classList.add('kbd');
    v[kbdIdx].scrollIntoView({block:'nearest'});
  }
  function filter(q){
    q=q.trim().toLowerCase();
    var any=false;
    opts.forEach(function(o){
      var m=!q||o.dataset.search.indexOf(q)!==-1;
      o.hidden=!m;
      if(m) any=true;
    });
    empty.hidden=any;
    kbdIdx=-1;
    clearKbd();
  }
  function open(){
    menu.classList.add('open');
    btn.setAttribute('aria-expanded','true');
    setTimeout(function(){try{(search||grid.querySelector('.lang-opt.on')||opts[0]).focus();}catch(e){}},20);
  }
  function close(){
    menu.classList.remove('open');
    btn.setAttribute('aria-expanded','false');
    if(search)search.value='';
    filter('');
  }

  btn.addEventListener('click',function(e){
    e.stopPropagation();
    if(menu.classList.contains('open')) close(); else open();
  });
  menu.addEventListener('click',function(e){e.stopPropagation();});
  if(search){
  search.addEventListener('input',function(){filter(search.value);});
  search.addEventListener('keydown',function(e){
    var v=visible();
    if(e.key==='ArrowDown'){e.preventDefault();setKbd(kbdIdx<0?0:kbdIdx+1);}
    else if(e.key==='ArrowUp'){e.preventDefault();setKbd(kbdIdx<0?v.length-1:kbdIdx-1);}
    else if(e.key==='Enter'){
      e.preventDefault();
      if(kbdIdx>=0&&v[kbdIdx]){window.location.href=v[kbdIdx].getAttribute('href');}
      else if(v.length===1){window.location.href=v[0].getAttribute('href');}
    }
    else if(e.key==='Escape'){e.preventDefault();close();btn.focus();}
  });
  }
  document.addEventListener('click',function(e){
    if(!sw.contains(e.target)&&menu.classList.contains('open')) close();
  });
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&menu.classList.contains('open')){close();btn.focus();}
  });
})();
</script>

<!-- Auth Modal -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <button class="modal-close" onclick="closeModal()">&times;</button>

    <!-- Header -->
    <div class="modal-head">
      <div class="modal-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
      </div>
      <div id="modal-title" class="modal-h2" style="font-size:19px;font-weight:800;letter-spacing:-.02em;margin-bottom:4px">欢迎回来</div>
      <p class="modal-desc" id="modal-desc">访问您的服务器控制面板</p>
    </div>

    <!-- Tabs -->
    <div class="modal-tabs">
      <a id="mtab-login" class="on" onclick="switchTab('login')">登录</a>
      <a id="mtab-register" onclick="switchTab('register')">注册</a>
    </div>

    <!-- Login -->
    <div class="modal-body" id="tab-login">
      <form id="loginForm" onsubmit="doLogin(event)">
        <input type="hidden" name="_token" value="c03e45df8e27a9266fd185c09a1efb2bdd5497765a4b14b1c2ce20cceeb687bf">

        <div id="loginStepToken">
          <label>访问令牌</label>
          <input type="text" id="loginToken" name="token" placeholder="XXXX-XXXX-XXXX-XXXX" autocomplete="off" spellcheck="false" required>
        </div>

        <div id="loginStepTotp" style="display:none">
          <label>双重验证码</label>
          <input type="text" id="loginTotp" name="totp" placeholder="123456" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" spellcheck="false">
          <p class="modal-totp-hint">请输入身份验证器应用中的 6 位验证码。</p>
        </div>

        <div id="loginError" style="display:none;font-size:12px;color:#dc2626;margin-bottom:10px"></div>
        <button type="submit" class="bt bt-p" style="width:100%" id="loginBtn">登录</button>
      </form>
    </div>

    <!-- Register -->
    <div class="modal-body" id="tab-register" style="display:none">
      <!-- Step A: explainer + create button -->
      <div id="register-intro">
        <div class="modal-notice">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          <div>
            <strong>创建账户免费且即时完成。</strong>
            <p>一个令牌即可取代你的姓名、邮箱和密码。我们在创建时即对其哈希处理，此后再也无法看到完整值。部署前需要先充值。</p>
          </div>
        </div>
        <div class="modal-steps">
          <div class="modal-step"><span class="modal-step-num">1</span> 点击下方生成你的令牌</div>
          <div class="modal-step"><span class="modal-step-num">2</span> 请妥善保存（我们无法找回）</div>
          <div class="modal-step"><span class="modal-step-num">3</span> 充值并部署任意服务</div>
        </div>
        <button type="button" class="bt bt-p" style="width:100%" id="signupBtn">创建我的令牌</button>
        <div id="signupError" style="display:none;font-size:12px;color:#dc2626;margin-top:8px"></div>
      </div>

      <!-- Step B: token reveal + saved gate -->
      <div id="register-token" style="display:none">
        <div class="modal-token-banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 3v6c0 4.5-3.4 8.5-8 9.5C7.4 20.5 4 16.5 4 12V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
          <div class="modal-token-banner-tx">
            <strong>你的访问令牌 — 仅显示一次</strong>
            <p>请立即复制 — 我们无法找回、重置或再次显示。</p>
          </div>
        </div>
        <div class="modal-token-box">
          <code id="newTokenValue">XXXX-XXXX-XXXX-XXXX</code>
          <button type="button" id="copyTokenBtn" class="modal-token-copy" data-copy="">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="5" width="9" height="9" rx="1.4"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg>
            <span>复制</span>
          </button>
        </div>
        <button type="button" class="bt bt-p" style="width:100%;margin-top:12px" id="continueBtn">进入我的账户</button>
      </div>
    </div>

    <!-- Footer -->
    <div class="modal-footer" id="modal-footer-login">
      没有账户？ <a href="#" onclick="switchTab('register');return false">查看注册方式</a>
    </div>
    <div class="modal-footer" id="modal-footer-register" style="display:none">
      已有令牌？ <a href="#" onclick="switchTab('login');return false">登录</a>
    </div>
  </div>
</div>

<script>
function openModal(tab){
  document.getElementById('modalOverlay').classList.add('on');
  document.body.style.overflow='hidden';
  switchTab(tab||'login');
}
function closeModal(){
  document.getElementById('modalOverlay').classList.remove('on');
  document.body.style.overflow='';
}
function switchTab(t){
  var isLogin=t==='login';
  document.getElementById('tab-login').style.display=isLogin?'':'none';
  document.getElementById('tab-register').style.display=isLogin?'none':'';
  document.getElementById('modal-footer-login').style.display=isLogin?'':'none';
  document.getElementById('modal-footer-register').style.display=isLogin?'none':'';
  document.getElementById('mtab-login').className=isLogin?'on':'';
  document.getElementById('mtab-register').className=isLogin?'':'on';
  document.getElementById('modal-title').textContent=isLogin?"\u6b22\u8fce\u56de\u6765":"\u521b\u5efa\u8d26\u6237";
  document.getElementById('modal-desc').textContent=isLogin?"\u8bbf\u95ee\u60a8\u7684\u670d\u52a1\u5668\u63a7\u5236\u9762\u677f":"\u53ea\u9700\u4e00\u7b14\u8ba2\u5355\u5373\u53ef";
}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal()});

function doLogin(e){
  e.preventDefault();
  var btn=document.getElementById('loginBtn');
  var err=document.getElementById('loginError');
  var token=document.getElementById('loginToken').value.trim();
  var totpEl=document.getElementById('loginTotp');
  var totp=totpEl?totpEl.value.trim():'';
  if(!token)return;
  btn.textContent="\u6b63\u5728\u767b\u5f55\u2026\u2026";btn.disabled=true;
  err.style.display='none';
  var fd=new FormData();
  fd.append('action','login');
  fd.append('token',token);
  if(totp) fd.append('totp',totp);
  fd.append('_token','c03e45df8e27a9266fd185c09a1efb2bdd5497765a4b14b1c2ce20cceeb687bf');
  fetch("\/zh\/auth-api.php",{method:'POST',body:fd})
    .then(r=>r.json())
    .then(d=>{
      if(d.ok){
        var sp=new URLSearchParams(location.search);
        var ret=sp.get('return');
        window.location.href=ret||d.redirect||"\/zh\/account";
        return;
      }
      if(d.totp_required){
        document.getElementById('loginStepToken').style.display='none';
        document.getElementById('loginStepTotp').style.display='';
        if(totpEl){totpEl.focus();totpEl.value='';}
        if(d.error){err.textContent=d.error;err.style.display='block';}
        btn.textContent="\u9a8c\u8bc1\u7801";btn.disabled=false;
        return;
      }
      err.textContent=d.error||"\u767b\u5f55\u5931\u8d25\u3002";err.style.display='block';btn.textContent="\u767b\u5f55";btn.disabled=false;
    })
    .catch(()=>{err.textContent="\u7f51\u7edc\u9519\u8bef\u3002";err.style.display='block';btn.textContent="\u767b\u5f55";btn.disabled=false;});
}

// Signup flow: create token → reveal once → "I saved it" gate → auto-login
(function(){
  var newToken='';
  var btn=document.getElementById('signupBtn');
  var err=document.getElementById('signupError');
  var intro=document.getElementById('register-intro');
  var tokenStep=document.getElementById('register-token');
  var tokenEl=document.getElementById('newTokenValue');
  var copyBtn=document.getElementById('copyTokenBtn');
  var contBtn=document.getElementById('continueBtn');
  if(!btn) return;

  btn.addEventListener('click',function(){
    btn.disabled=true;btn.textContent="\u6b63\u5728\u521b\u5efa\u2026\u2026";err.style.display='none';
    var fd=new FormData();fd.append('action','signup');fd.append('_token','c03e45df8e27a9266fd185c09a1efb2bdd5497765a4b14b1c2ce20cceeb687bf');
    fetch("\/zh\/auth-api.php",{method:'POST',body:fd}).then(r=>r.json()).then(d=>{
      if(!d.ok){err.textContent=d.error||"\u8d26\u6237\u521b\u5efa\u5931\u8d25\u3002";err.style.display='block';btn.disabled=false;btn.textContent="\u521b\u5efa\u6211\u7684\u4ee4\u724c";return;}
      newToken=d.token;
      tokenEl.textContent=d.token;
      copyBtn.dataset.copy=d.token;
      intro.style.display='none';
      tokenStep.style.display='';
    }).catch(()=>{err.textContent="\u7f51\u7edc\u9519\u8bef\u3002";err.style.display='block';btn.disabled=false;btn.textContent="\u521b\u5efa\u6211\u7684\u4ee4\u724c";});
  });

  copyBtn.addEventListener('click',function(){
    if(!newToken) return;
    navigator.clipboard.writeText(newToken).then(function(){
      var lbl=copyBtn.querySelector('span');
      var prev=lbl.textContent;lbl.textContent="\u5df2\u590d\u5236";copyBtn.classList.add('on');
      setTimeout(function(){lbl.textContent=prev;copyBtn.classList.remove('on');},1400);
    });
  });

  contBtn.addEventListener('click',function(){
    if(!newToken) return;
    contBtn.disabled=true;contBtn.textContent="\u6b63\u5728\u767b\u5f55\u2026\u2026";
    var fd=new FormData();fd.append('action','login');fd.append('token',newToken);fd.append('_token','c03e45df8e27a9266fd185c09a1efb2bdd5497765a4b14b1c2ce20cceeb687bf');
    fetch("\/zh\/auth-api.php",{method:'POST',body:fd}).then(r=>r.json()).then(d=>{
      var sp=new URLSearchParams(location.search);
      var ret=sp.get('return');
      window.location.href=ret||d.redirect||"\/zh\/account";
    });
  });
})();

// Auto-open modal on ?signup=1 or ?login=1
(function(){
  var sp=new URLSearchParams(location.search);
  if(sp.get('signup')==='1') openModal('register');
  else if(sp.get('login')==='1') openModal('login');
})();
</script>

