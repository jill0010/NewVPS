48 GB DDR5","disk":"600 GB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false},{"name":"RO-PRO","price":49,"cpu":"16 vCPU","proc":"AMD EPYC 9254","ram":"64 GB DDR5","disk":"1 TB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false}]},"switzerland":{"name":"Switzerland","flag":"ch","plans":[{"name":"CH-S","price":11,"cpu":"2 vCPU","proc":"AMD EPYC 75F3 (3.2 GHz)","ram":"4 GB DDR4","disk":"60 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"CH-M","price":17,"cpu":"4 vCPU","proc":"AMD EPYC 75F3 (3.2 GHz)","ram":"8 GB DDR4","disk":"120 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"CH-L","price":24.5,"cpu":"6 vCPU","proc":"AMD EPYC 75F3 (3.2 GHz)","ram":"16 GB DDR4","disk":"200 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":true},{"name":"CH-XL","price":34.5,"cpu":"8 vCPU","proc":"AMD EPYC 9474F (3.6 GHz)","ram":"32 GB DDR5","disk":"400 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"CH-XXL","price":46.5,"cpu":"12 vCPU","proc":"AMD EPYC 9474F (3.6 GHz)","ram":"48 GB DDR5","disk":"600 GB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false},{"name":"CH-PRO","price":58.5,"cpu":"16 vCPU","proc":"AMD EPYC 9474F (3.6 GHz)","ram":"64 GB DDR5","disk":"1 TB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false}]},"netherlands":{"name":"Netherlands","flag":"nl","plans":[{"name":"NL-S","price":9,"cpu":"2 vCPU","proc":"AMD EPYC 7543","ram":"4 GB DDR4","disk":"60 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"NL-M","price":14.5,"cpu":"4 vCPU","proc":"AMD EPYC 7543","ram":"8 GB DDR4","disk":"120 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"NL-L","price":21,"cpu":"6 vCPU","proc":"AMD EPYC 7543","ram":"16 GB DDR4","disk":"200 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":true},{"name":"NL-XL","price":29.5,"cpu":"8 vCPU","proc":"AMD EPYC 9354","ram":"32 GB DDR5","disk":"400 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"NL-XXL","price":39,"cpu":"12 vCPU","proc":"AMD EPYC 9354","ram":"48 GB DDR5","disk":"600 GB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false},{"name":"NL-PRO","price":54,"cpu":"16 vCPU","proc":"AMD EPYC 9354","ram":"64 GB DDR5","disk":"1 TB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false}]},"russia":{"name":"Russia","flag":"ru","plans":[{"name":"RU-S","price":7.5,"cpu":"2 vCPU","proc":"AMD EPYC 7313P","ram":"4 GB DDR4","disk":"60 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"RU-M","price":12,"cpu":"4 vCPU","proc":"AMD EPYC 7313P","ram":"8 GB DDR4","disk":"120 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"RU-L","price":17,"cpu":"6 vCPU","proc":"AMD EPYC 7313P","ram":"16 GB DDR4","disk":"200 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":true},{"name":"RU-XL","price":24.5,"cpu":"8 vCPU","proc":"AMD EPYC 9124","ram":"32 GB DDR5","disk":"400 GB NVMe","bw":"Unlimited","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"RU-XXL","price":34.5,"cpu":"12 vCPU","proc":"AMD EPYC 9124","ram":"48 GB DDR5","disk":"600 GB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false},{"name":"RU-PRO","price":44,"cpu":"16 vCPU","proc":"AMD EPYC 9124","ram":"64 GB DDR5","disk":"1 TB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false}]}};
          var disc = {1:0, 3:25, 6:35, 12:50};
          var bal  = 0;
          var csrf = "c03e45df8e27a9266fd185c09a1efb2bdd5497765a4b14b1c2ce20cceeb687bf";
          var isGpu = false;
          var GPU = null;
          var TIER = {S:"\u5c0f\u578b",M:"\u4e2d\u578b",L:"\u5927\u578b",XL:"\u8d85\u5927\u578b",XXL:"\u5de8\u578b",PRO:"Pro",'1':"\u5c0f\u578b",'2':"\u4e2d\u578b",'3':"\u5927\u578b",'4':"\u8d85\u5927\u578b"};
          var T = {
            popular:"\u70ed\u95e8", from:"\u8d77", change:"\u66f4\u6539",
            deploy:"\u90e8\u7f72", topup:"\u7acb\u5373\u5145\u503c", working:"\u6b63\u5728\u90e8\u7f72\u2026",
            forN:"\u5171 :n \u4e2a\u6708", netErr:"\u7f51\u7edc\u9519\u8bef\u3002", genErr:"\u90e8\u7f72\u5931\u8d25\uff0c\u8bf7\u91cd\u8bd5\u3002",
            needs:"\u9700\u8981 :n GB", gated:"\u53d7\u9650", pwReq:"\u8bf7\u8bbe\u7f6e root \u5bc6\u7801\uff08\u81f3\u5c11 8 \u4e2a\u5b57\u7b26\uff09\u3002", none:"\u65e0 AI \u6a21\u677f\u2014\u2014\u7eaf CUDA \u673a\u5668\u3002",
            // Deux gabarits : PHP remplace :n par {n}, le JS substitue ensuite.
            // La forme singuliere est distincte, sinon "+1 Months" en anglais.
            monthsOne:"1 \u4e2a\u6708",
            monthsFmt:"{n} \u4e2a\u6708",
            promoHint:"\u60a8\u652f\u4ed8 {paid}\uff0c\u670d\u52a1\u5668\u8fd0\u884c {total}\u3002"          };
          var promoOn = false;

          var root = document.getElementById('vdw-' + type);
          if (!root) return;
          var $ = function(n){ return root.querySelector('[data-el="' + n + '"]'); };
          var plansEl=$('plans'), locsEl=$('locs'), recapEl=$('recap'), osSel=$('os'), termsEl=$('terms'),
              totalEl=$('total'), btn=$('btn'), msg=$('msg'), backEl=$('back'), pwEl=$('pw'), genpwEl=$('genpw');
          var panes = [].slice.call(root.querySelectorAll('.vdw-pane'));
          var steps = [].slice.call(root.querySelectorAll('.vdw-step'));

          var locKeys = Object.keys(cat), firstLoc = locKeys[0];
          function tierName(sku){ var s = sku.indexOf('-')>=0 ? sku.slice(sku.indexOf('-')+1) : sku; return TIER[s] || s; }
          var tiers = cat[firstLoc].plans.map(function(p,i){
            var from = Infinity; locKeys.forEach(function(k){ var pr = cat[k].plans[i].price; if (pr < from) from = pr; });
            return { i:i, name:tierName(p.name), cpu:p.cpu, proc:p.proc, ram:p.ram, disk:p.disk, bw:p.bw, up:p.up, gpu:p.gpu, vram:p.vram, pop:p.pop, from:from };
          });
          var defTier = (tiers.filter(function(t){return t.pop;})[0] || tiers[Math.min(2, tiers.length-1)]).i;
          var state = { tier:defTier, loc:firstLoc, months:1, stacks:new Set(), models:new Set() };
          if (isGpu) Object.keys(GPU.stacks).forEach(function(s){ if (GPU.stacks[s].def) state.stacks.add(s); });

          function money(n){ return '$' + (Math.round(n*100)/100).toFixed(2); }
          function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
          function planFor(loc,i){ return cat[loc].plans[i]; }
          function total(){ var p=planFor(state.loc,state.tier), d=disc[state.months]||0; return (p.price*(1-d/100))*state.months; }

          function specRows(t){
            if (type === 'gpu')        return [['GPU',t.gpu],['VRAM',t.vram],['CPU',t.cpu],['RAM',t.ram],['Disk',t.disk]];
            if (type === 'dedicated')  return [['CPU',t.cpu],['Model',t.proc],['RAM',t.ram],['Disk',t.disk],['Network',t.up]];
            if (type === 'rdp')        return [['CPU',t.cpu],['RAM',t.ram],['Disk',t.disk],['Bandwidth',t.bw+'/mo'],['Uplink',t.up]];
            return [['CPU',t.cpu],['RAM',t.ram],['Disk',t.disk],['Network',t.bw+' · '+t.up]];
          }

          function renderPlans(){
            plansEl.innerHTML = tiers.map(function(t){
              var rows = specRows(t).map(function(r){ return '<span class="vdp-row"><i>'+esc(r[0])+'</i><b>'+esc(r[1])+'</b></span>'; }).join('');
              return '<button type="button" class="vdp'+(t.i===state.tier?' on':'')+'" data-tier="'+t.i+'">'
                + '<span class="vdp-check" aria-hidden="true">✓</span>'
                + '<span class="vdp-top"><span class="vdp-name">'+esc(t.name)+'</span>'+(t.pop?'<span class="vdp-pop">'+T.popular+'</span>':'')+'</span>'
                + '<span class="vdp-specs">'+rows+'</span>'
                + '<span class="vdp-foot"><span class="vdp-price"><i>'+T.from+'</i> <b>'+money(t.from)+'</b><i>/mo</i></span></span>'
                + '</button>';
            }).join('');
          }
          function renderLocs(){
            locsEl.innerHTML = locKeys.map(function(k){
              var pr = planFor(k,state.tier).price;
              return '<button type="button" class="vdl'+(k===state.loc?' on':'')+'" data-loc="'+k+'">'
                + '<span class="fi fi-'+cat[k].flag+'"></span>'
                + '<span class="vdl-body"><span class="vdl-name">'+esc(cat[k].name)+'</span><span class="vdl-price"><b>'+money(pr)+'</b>/mo</span></span>'
                + '</button>';
            }).join('');
          }
          function recapText(t){
            if (type === 'gpu') return t.gpu + ' · ' + t.vram + ' · ' + t.cpu + ' · ' + t.ram;
            return t.cpu + ' · ' + t.ram + ' · ' + t.disk;
          }
          function renderRecap(){
            var t = tiers[state.tier];
            recapEl.innerHTML = '<div class="vdw-recap-l"><span class="vdw-recap-name">'+esc(t.name)+'</span><span class="vdw-recap-spec">'+esc(recapText(t))+'</span></div>'
              + '<button type="button" class="vdw-recap-ch" data-el="change">'+T.change+'</button>';
            recapEl.querySelector('[data-el="change"]').addEventListener('click', function(){ goStep(1); });
          }
          // Duree servie : lue sur le bouton, que PHP a rempli depuis
          // sp_promo_service_months(). Le navigateur n'a pas a savoir que le
          // facteur vaut 2 ni sur quelles gammes l'offre porte.
          function servedMonths(){
            var b=termsEl.querySelector('.vdw-term[data-m="'+state.months+'"]');
            var v=b?parseInt(b.dataset.served||'0',10):0;
            return v>0?v:state.months;
          }
          function moLabel(n){ return n===1 ? T.monthsOne : T.monthsFmt.replace('{n}',n); }
          function renderPromo(){
            var el=$('promoLive');
            if(!promoOn||!el) return;
            el.textContent=T.promoHint.replace('{paid}',moLabel(state.months))
                                      .replace('{total}',moLabel(servedMonths()));
          }

          function renderTotal(){
            var d=disc[state.months]||0, tot=total();
            var line='<b>'+money(tot)+'</b><i>'+T.forN.replace(':n',state.months)+'</i>';
            if (d>0) line+='<span class="vdw-save">−'+d+'%</span>';
            if (promoOn) line+='<span class="vdw-x2-tot">'+state.months+' → '+servedMonths()+'</span>';
            totalEl.innerHTML=line;
            renderPromo();
            if (bal+0.001>=tot){ btn.textContent=T.deploy+' · '+money(tot); btn.dataset.mode='deploy'; btn.classList.remove('bt-o'); btn.classList.add('bt-p'); }
            else { var def=Math.round((tot-bal)*100)/100; btn.textContent=T.topup+' '+money(def); btn.dataset.mode='topup'; btn.dataset.deficit=def; btn.classList.remove('bt-p'); btn.classList.add('bt-o'); }
            btn.disabled=false; msg.textContent='';
          }
          function goStep(n){
            panes.forEach(function(p){ p.classList.toggle('on', +p.dataset.step===n); });
            steps.forEach(function(s){ var i=+s.dataset.i; s.classList.toggle('on', i===n); s.classList.toggle('done', i<n); });
            if (n===2){ renderRecap(); renderLocs(); renderTotal(); if (isGpu) refreshGpu(); }
          }

          // ── GPU AI config ──
          var hfEl, shutEl, pubEl, recipesEl, stacksEl, modelsEl, aiSumEl, aiRegion, aiNoCuda, hfWarn;
          if (isGpu){
            hfEl=$('hf'); shutEl=$('shut'); pubEl=$('pub');
            recipesEl=$('recipes'); stacksEl=$('stacks'); modelsEl=$('models'); aiSumEl=$('aiSum');
            aiRegion=$('aiRegion'); aiNoCuda=$('aiNoCuda'); hfWarn=$('hfWarn');
          }
          function vram(){ return GPU.vramTiers[state.tier] || 0; }
          function osCuda(){ return GPU.cuda.indexOf(osSel.value) !== -1; }
          function gpuGate(){
            state.stacks.forEach(function(s){ if (!GPU.stacks[s].def && GPU.stacks[s].vram > vram()) state.stacks.delete(s); });
            state.models.forEach(function(m){ if ((GPU.models[m].vram||0) > vram()) state.models.delete(m); });
          }
          function renderRecipes(){
            recipesEl.innerHTML = GPU.recipes.map(function(r){
              var lock = r.minVram > vram();
              return '<button type="button" class="vdg-recipe'+(lock?' lock':'')+'" data-stacks="'+esc(r.stacks.join(','))+'" data-models="'+esc(r.models.join(','))+'"'+(lock?' disabled':'')+'>'
                + '<strong>'+esc(r.title)+'</strong><em>'+esc(r.sub)+'</em>'
                + (lock?'<span class="vdg-lock">'+T.needs.replace(':n',r.minVram)+'</span>':'')
                + '</button>';
            }).join('');
          }
          function chipHtml(kind, slug){
            var it = (kind==='stacks'?GPU.stacks:GPU.models)[slug];
            var sel = (kind==='stacks'?state.stacks:state.models).has(slug);
            var lock = (it.vram||0) > vram();
            var cls = 'vdg-chip'+(sel?' on':'')+(lock?' lock':'')+(it.def?' locked-on':'')+(it.gated?' gated':'');
            var meta = (it.size?('<small>'+it.size+'G</small>'):'') + (it.gated?'<span class="vdg-g">'+T.gated+'</span>':'') + (lock?'<span class="vdg-need">'+T.needs.replace(':n',it.vram)+'</span>':'');
            return '<button type="button" class="'+cls+'" data-kind="'+kind+'" data-slug="'+esc(slug)+'"'+((lock||it.def)?' disabled':'')+'>'+esc(it.name)+' '+meta+'</button>';
          }
          function renderChips(){
            var byCat = function(items, labels){
              var cats={}; Object.keys(items).forEach(function(s){ (cats[items[s].cat]=cats[items[s].cat]||[]).push(s); });
              return Object.keys(cats).map(function(c){
                return '<div class="vdg-cat"><span class="vdg-cat-h">'+esc(labels[c]||c)+'</span>'+cats[c].map(function(s){return chipHtml(items===GPU.stacks?'stacks':'models', s);}).join('')+'</div>';
              }).join('');
            };
            stacksEl.innerHTML = byCat(GPU.stacks, GPU.stackCats);
            modelsEl.innerHTML = byCat(GPU.models, GPU.modelCats);
          }
          function aiSummary(){
            var names=[];
            state.stacks.forEach(function(s){ names.push(GPU.stacks[s].name); });
            state.models.forEach(function(m){ names.push(GPU.models[m].name); });
            aiSumEl.textContent = names.length ? ('✓ ' + names.join(' · ')) : T.none;
          }
          function hfWarnUpd(){
            var need=false; state.models.forEach(function(m){ if (GPU.models[m].gated) need=true; });
            hfWarn.hidden = !(need && !hfEl.value.trim());
          }
          function refreshGpu(){
            var cuda = osCuda();
            aiNoCuda.hidden = cuda; aiRegion.hidden = !cuda;
            gpuGate(); renderRecipes(); renderChips(); aiSummary(); hfWarnUpd();
          }

          // ── events ──
          plansEl.addEventListener('click', function(e){ var c=e.target.closest('.vdp'); if(!c)return; state.tier=+c.dataset.tier; renderPlans(); goStep(2); });
          locsEl.addEventListener('click', function(e){ var c=e.target.closest('.vdl'); if(!c)return; state.loc=c.dataset.loc; renderLocs(); renderTotal(); });
          termsEl.addEventListener('click', function(e){ var c=e.target.closest('.vdw-term'); if(!c)return; state.months=+c.dataset.m; termsEl.querySelectorAll('.vdw-term').forEach(function(b){b.classList.toggle('on',b===c);}); renderTotal(); });
          osSel.addEventListener('change', function(){ renderTotal(); if (isGpu) refreshGpu(); });
          backEl.addEventListener('click', function(){ goStep(1); });
          steps.forEach(function(s){ s.addEventListener('click', function(){ goStep(+s.dataset.i); }); });
          function genPassword(){ var c='ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@#$%*-_', n=18, out='', a=new Uint32Array(n); (window.crypto||window.msCrypto).getRandomValues(a); for (var i=0;i<n;i++) out+=c.charAt(a[i]%c.length); return out; }
          if (genpwEl) genpwEl.addEventListener('click', function(){ pwEl.value=genPassword(); pwEl.focus(); pwEl.select(); });

          if (isGpu){
            recipesEl.addEventListener('click', function(e){
              var c=e.target.closest('.vdg-recipe'); if(!c||c.disabled)return;
              state.stacks=new Set(); Object.keys(GPU.stacks).forEach(function(s){ if (GPU.stacks[s].def) state.stacks.add(s); });
              state.models=new Set();
              (c.dataset.stacks?c.dataset.stacks.split(','):[]).forEach(function(s){ state.stacks.add(s); });
              (c.dataset.models?c.dataset.models.split(','):[]).forEach(function(s){ state.models.add(s); });
              refreshGpu();
            });
            function chipClick(e){
              var c=e.target.closest('.vdg-chip'); if(!c||c.disabled)return;
              var set = c.dataset.kind==='stacks'?state.stacks:state.models;
              if (set.has(c.dataset.slug)) set.delete(c.dataset.slug); else set.add(c.dataset.slug);
              renderChips(); aiSummary(); hfWarnUpd();
            }
            stacksEl.addEventListener('click', chipClick);
            modelsEl.addEventListener('click', chipClick);
            hfEl.addEventListener('input', hfWarnUpd);
          }

          btn.addEventListener('click', function(){
            if (btn.dataset.mode==='topup'){ window.location.href='?tab=topup&need='+(btn.dataset.deficit||''); return; }
            var p=planFor(state.loc,state.tier); if(!p)return;
            if (isGpu && (!pwEl.value || pwEl.value.length<8)){ msg.textContent=T.pwReq; pwEl.focus(); return; }
            var prev=btn.textContent; btn.disabled=true; btn.textContent=T.working; msg.textContent='';
            var fd=new FormData();
            fd.append('action','create'); fd.append('type',type); fd.append('plan',p.name);
            fd.append('location',state.loc); fd.append('os',osSel.value); fd.append('billing',state.months); fd.append('_token',csrf);
            if (pwEl.value) fd.append('password',pwEl.value);
            if (isGpu){
              fd.append('auto_shutdown_hours',shutEl.value);
              if (osCuda()){
                state.stacks.forEach(function(s){ fd.append('ai_stacks[]',s); });
                state.models.forEach(function(m){ fd.append('pretrained_models[]',m); });
                if (hfEl.value.trim()) fd.append('hf_token',hfEl.value.trim());
                if (pubEl.checked) fd.append('public_endpoint','1');
              }
            }
            fetch('/pay-api.php',{method:'POST',body:fd,headers:{'X-CSRF-TOKEN':csrf}})
              .then(function(r){return r.json();})
              .then(function(d){
                if (d && d.ok && d.redirect){ window.location.href=d.redirect; return; }
                if (d && d.insufficient && d.redirect){ window.location.href=d.redirect; return; }
                msg.textContent=(d&&d.error)?d.error:T.genErr; btn.disabled=false; btn.textContent=prev;
              })
              .catch(function(){ msg.textContent=T.netErr; btn.disabled=false; btn.textContent=prev; });
          });

          renderPlans();
        })();
        </script>

              </div>
            <div class="dash-tab" data-pane="dedicated">
        <header class="dash-h">
          <h2>独立服务器 <span class="dash-h-cnt">0</span></h2>
          <p>独占裸金属服务器 — 无邻居，无资源争抢，专属机器。</p>
          <div class="dash-h-r">
            <a href="/zh/dedicated" class="bt bt-p bt-sm">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 3v10M3 8h10"/></svg>
              订购新 独立服务器            </a>
          </div>
        </header>

                <section class="vdw" id="vdw-dedicated" data-type="dedicated">
          <div class="vdw-head">
            <div class="vdw-head-l">
              <h3>部署独立服务器</h3>
              <p>选择套餐和位置——从余额扣款，几分钟内就绪。</p>
            </div>
          </div>

          
          <div class="vdw-steps">
            <button type="button" class="vdw-step on" data-i="1"><span class="vdw-num">1</span><span class="vdw-lbl">选择套餐</span></button>
            <span class="vdw-sep"></span>
            <button type="button" class="vdw-step" data-i="2"><span class="vdw-num">2</span><span class="vdw-lbl">位置与选项</span></button>
          </div>

          <div class="vdw-pane on" data-step="1">
            <div class="vdw-plans" data-el="plans"></div>
          </div>

          <div class="vdw-pane" data-step="2">
            <div class="vdw-recap" data-el="recap"></div>

            <div class="vdw-lab">地区</div>
            <div class="vdw-locs" data-el="locs"></div>

            <div class="vdw-opts">
              <label class="vdw-f">
                <span>操作系统</span>
                <select data-el="os">
                                    <optgroup label="Debian / Ubuntu">
                                        <option value="ubuntu-24" selected>Ubuntu 24.04 LTS</option>
                                        <option value="ubuntu-22">Ubuntu 22.04 LTS</option>
                                        <option value="ubuntu-20">Ubuntu 20.04 LTS</option>
                                        <option value="debian-13">Debian 13 Trixie</option>
                                        <option value="debian-12">Debian 12 Bookworm</option>
                                        <option value="debian-11">Debian 11 Bullseye</option>
                                      </optgroup>
                                    <optgroup label="RHEL / CentOS">
                                        <option value="alma-9">AlmaLinux 9</option>
                                        <option value="alma-8">AlmaLinux 8</option>
                                        <option value="rocky-9">Rocky Linux 9</option>
                                        <option value="rocky-8">Rocky Linux 8</option>
                                        <option value="centos-9">CentOS Stream 9</option>
                                        <option value="fedora-41">Fedora 41</option>
                                      </optgroup>
                                    <optgroup label="BSD / Other">
                                        <option value="freebsd-14">FreeBSD 14</option>
                                        <option value="freebsd-13">FreeBSD 13</option>
                                        <option value="arch">Arch Linux</option>
                                        <option value="opensuse-15">openSUSE 15.6</option>
                                      </optgroup>
                                    <optgroup label="Virtualization">
                                        <option value="proxmox-8">Proxmox VE 8</option>
                                        <option value="esxi-8">VMware ESXi 8</option>
                                      </optgroup>
                                    <optgroup label="Security / Firewall">
                                        <option value="whonix">Whonix Gateway</option>
                                        <option value="pfsense">pfSense CE</option>
                                        <option value="opnsense">OPNsense</option>
                                      </optgroup>
                                    <optgroup label="Custom">
                                        <option value="custom-iso">Custom ISO (upload later)</option>
                                      </optgroup>
                                  </select>
              </label>
              <div class="vdw-f">
                <span>计费周期</span>
                <div class="vdw-terms" data-el="terms">
                                    <button type="button" class="vdw-term on" data-m="1" data-served="1">1 个月</button>
                  <button type="button" class="vdw-term" data-m="3" data-served="3">3 个月<em>&minus;25%</em></button>
                  <button type="button" class="vdw-term" data-m="6" data-served="6">6 个月<em>&minus;35%</em></button>
                  <button type="button" class="vdw-term" data-m="12" data-served="12">12 个月<em>&minus;50%</em></button>
                </div>
                              </div>
            </div>

            <div class="vdw-creds">
              <div class="vdw-lab">登录名与密码</div>
              <div class="vdw-cred-row">
                <div class="vdw-cred-user"><span>用户名</span><b>root</b></div>
                <div class="vdw-cred-pw">
                  <input type="text" data-el="pw" class="vdw-input" autocomplete="off" spellcheck="false" placeholder="设置或生成密码">
                  <button type="button" class="bt bt-o bt-sm" data-el="genpw">生成</button>
                </div>
              </div>
              <p class="vdw-hint">可选——生成一个强 root 密码并立即复制。</p>
            </div>

            
            <div class="vdw-foot">
              <button type="button" class="bt bt-o bt-sm vdw-back" data-el="back">&larr; 返回</button>
              <div class="vdw-total" data-el="total"></div>
              <div class="vdw-act">
                <span class="vdw-msg" data-el="msg"></span>
                <button type="button" class="bt bt-p" data-el="btn">部署</button>
              </div>
            </div>
          </div>
        </section>

        <script>
        (function(){
          var type = "dedicated";
          var cat  = {"iceland":{"name":"Iceland","flag":"is","plans":[{"name":"IS-1","price":63,"cpu":"8C / 16T","proc":"Intel Xeon E-2388G (3.2 GHz)","ram":"64 GB DDR4 ECC","disk":"2x 1TB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false},{"name":"IS-2","price":112,"cpu":"16C / 32T","proc":"AMD Ryzen 9 7950X (4.5 GHz)","ram":"128 GB DDR5","disk":"2x 2TB NVMe","bw":"Unlimited","up":"5 Gbps","gpu":"","vram":"","pop":true},{"name":"IS-3","price":185.5,"cpu":"32C / 64T","proc":"AMD EPYC 9354 (3.25 GHz)","ram":"128 GB DDR5 ECC","disk":"4x 2TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false},{"name":"IS-4","price":279,"cpu":"64C / 128T","proc":"2× AMD EPYC 9354 (3.25 GHz)","ram":"256 GB DDR5 ECC","disk":"4x 4TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false}]},"panama":{"name":"Panama","flag":"pa","plans":[{"name":"PA-1","price":53.5,"cpu":"8C / 16T","proc":"Intel Xeon E-2388G (3.2 GHz)","ram":"64 GB DDR4 ECC","disk":"2x 1TB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false},{"name":"PA-2","price":97.5,"cpu":"16C / 32T","proc":"AMD Ryzen 9 7950X (4.5 GHz)","ram":"128 GB DDR5","disk":"2x 2TB NVMe","bw":"Unlimited","up":"5 Gbps","gpu":"","vram":"","pop":true},{"name":"PA-3","price":161,"cpu":"32C / 64T","proc":"AMD EPYC 9354 (3.25 GHz)","ram":"128 GB DDR5 ECC","disk":"4x 2TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false},{"name":"PA-4","price":244.5,"cpu":"64C / 128T","proc":"2× AMD EPYC 9354 (3.25 GHz)","ram":"256 GB DDR5 ECC","disk":"4x 4TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false}]},"moldova":{"name":"Moldova","flag":"md","plans":[{"name":"MD-1","price":48.5,"cpu":"8C / 16T","proc":"Intel Xeon E-2388G (3.2 GHz)","ram":"64 GB DDR4 ECC","disk":"2x 1TB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false},{"name":"MD-2","price":87.5,"cpu":"16C / 32T","proc":"AMD Ryzen 9 7950X (4.5 GHz)","ram":"128 GB DDR5","disk":"2x 2TB NVMe","bw":"Unlimited","up":"5 Gbps","gpu":"","vram":"","pop":true},{"name":"MD-3","price":146.5,"cpu":"32C / 64T","proc":"AMD EPYC 9354 (3.25 GHz)","ram":"128 GB DDR5 ECC","disk":"4x 2TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false},{"name":"MD-4","price":220,"cpu":"64C / 128T","proc":"2× AMD EPYC 9354 (3.25 GHz)","ram":"256 GB DDR5 ECC","disk":"4x 4TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false}]},"romania":{"name":"Romania","flag":"ro","plans":[{"name":"RO-1","price":53.5,"cpu":"8C / 16T","proc":"Intel Xeon E-2388G (3.2 GHz)","ram":"64 GB DDR4 ECC","disk":"2x 1TB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false},{"name":"RO-2","price":97.5,"cpu":"16C / 32T","proc":"AMD Ryzen 9 7950X (4.5 GHz)","ram":"128 GB DDR5","disk":"2x 2TB NVMe","bw":"Unlimited","up":"5 Gbps","gpu":"","vram":"","pop":true},{"name":"RO-3","price":161,"cpu":"32C / 64T","proc":"AMD EPYC 9354 (3.25 GHz)","ram":"128 GB DDR5 ECC","disk":"4x 2TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false},{"name":"RO-4","price":244.5,"cpu":"64C / 128T","proc":"2× AMD EPYC 9354 (3.25 GHz)","ram":"256 GB DDR5 ECC","disk":"4x 4TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false}]},"switzerland":{"name":"Switzerland","flag":"ch","plans":[{"name":"CH-1","price":68,"cpu":"8C / 16T","proc":"Intel Xeon E-2388G (3.2 GHz)","ram":"64 GB DDR4 ECC","disk":"2x 1TB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false},{"name":"CH-2","price":122,"cpu":"16C / 32T","proc":"AMD Ryzen 9 7950X (4.5 GHz)","ram":"128 GB DDR5","disk":"2x 2TB NVMe","bw":"Unlimited","up":"5 Gbps","gpu":"","vram":"","pop":true},{"name":"CH-3","price":195.5,"cpu":"32C / 64T","proc":"AMD EPYC 9354 (3.25 GHz)","ram":"128 GB DDR5 ECC","disk":"4x 2TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false},{"name":"CH-4","price":293.5,"cpu":"64C / 128T","proc":"2× AMD EPYC 9354 (3.25 GHz)","ram":"256 GB DDR5 ECC","disk":"4x 4TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false}]},"netherlands":{"name":"Netherlands","flag":"nl","plans":[{"name":"NL-1","price":58.5,"cpu":"8C / 16T","proc":"Intel Xeon E-2388G (3.2 GHz)","ram":"64 GB DDR4 ECC","disk":"2x 1TB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false},{"name":"NL-2","price":102.5,"cpu":"16C / 32T","proc":"AMD Ryzen 9 7950X (4.5 GHz)","ram":"128 GB DDR5","disk":"2x 2TB NVMe","bw":"Unlimited","up":"5 Gbps","gpu":"","vram":"","pop":true},{"name":"NL-3","price":171,"cpu":"32C / 64T","proc":"AMD EPYC 9354 (3.25 GHz)","ram":"128 GB DDR5 ECC","disk":"4x 2TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false},{"name":"NL-4","price":259,"cpu":"64C / 128T","proc":"2× AMD EPYC 9354 (3.25 GHz)","ram":"256 GB DDR5 ECC","disk":"4x 4TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false}]},"russia":{"name":"Russia","flag":"ru","plans":[{"name":"RU-1","price":48.5,"cpu":"8C / 16T","proc":"Intel Xeon E-2388G (3.2 GHz)","ram":"64 GB DDR4 ECC","disk":"2x 1TB NVMe","bw":"Unlimited","up":"2 Gbps","gpu":"","vram":"","pop":false},{"name":"RU-2","price":87.5,"cpu":"16C / 32T","proc":"AMD Ryzen 9 7950X (4.5 GHz)","ram":"128 GB DDR5","disk":"2x 2TB NVMe","bw":"Unlimited","up":"5 Gbps","gpu":"","vram":"","pop":true},{"name":"RU-3","price":146.5,"cpu":"32C / 64T","proc":"AMD EPYC 9354 (3.25 GHz)","ram":"128 GB DDR5 ECC","disk":"4x 2TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false},{"name":"RU-4","price":220,"cpu":"64C / 128T","proc":"2× AMD EPYC 9354 (3.25 GHz)","ram":"256 GB DDR5 ECC","disk":"4x 4TB NVMe","bw":"Unlimited","up":"10 Gbps","gpu":"","vram":"","pop":false}]}};
          var disc = {1:0, 3:25, 6:35, 12:50};
          var bal  = 0;
          var csrf = "c03e45df8e27a9266fd185c09a1efb2bdd5497765a4b14b1c2ce20cceeb687bf";
          var isGpu = false;
          var GPU = null;
          var TIER = {S:"\u5c0f\u578b",M:"\u4e2d\u578b",L:"\u5927\u578b",XL:"\u8d85\u5927\u578b",XXL:"\u5de8\u578b",PRO:"Pro",'1':"\u5c0f\u578b",'2':"\u4e2d\u578b",'3':"\u5927\u578b",'4':"\u8d85\u5927\u578b"};
          var T = {
            popular:"\u70ed\u95e8", from:"\u8d77", change:"\u66f4\u6539",
            deploy:"\u90e8\u7f72", topup:"\u7acb\u5373\u5145\u503c", working:"\u6b63\u5728\u90e8\u7f72\u2026",
            forN:"\u5171 :n \u4e2a\u6708", netErr:"\u7f51\u7edc\u9519\u8bef\u3002", genErr:"\u90e8\u7f72\u5931\u8d25\uff0c\u8bf7\u91cd\u8bd5\u3002",
            needs:"\u9700\u8981 :n GB", gated:"\u53d7\u9650", pwReq:"\u8bf7\u8bbe\u7f6e root \u5bc6\u7801\uff08\u81f3\u5c11 8 \u4e2a\u5b57\u7b26\uff09\u3002", none:"\u65e0 AI \u6a21\u677f\u2014\u2014\u7eaf CUDA \u673a\u5668\u3002",
            // Deux gabarits : PHP remplace :n par {n}, le JS substitue ensuite.
            // La forme singuliere est distincte, sinon "+1 Months" en anglais.
            monthsOne:"1 \u4e2a\u6708",
            monthsFmt:"{n} \u4e2a\u6708",
            promoHint:"\u60a8\u652f\u4ed8 {paid}\uff0c\u670d\u52a1\u5668\u8fd0\u884c {total}\u3002"          };
          var promoOn = false;

          var root = document.getElementById('vdw-' + type);
          if (!root) return;
          var $ = function(n){ return root.querySelector('[data-el="' + n + '"]'); };
          var plansEl=$('plans'), locsEl=$('locs'), recapEl=$('recap'), osSel=$('os'), termsEl=$('terms'),
              totalEl=$('total'), btn=$('btn'), msg=$('msg'), backEl=$('back'), pwEl=$('pw'), genpwEl=$('genpw');
          var panes = [].slice.call(root.querySelectorAll('.vdw-pane'));
          var steps = [].slice.call(root.querySelectorAll('.vdw-step'));

          var locKeys = Object.keys(cat), firstLoc = locKeys[0];
          function tierName(sku){ var s = sku.indexOf('-')>=0 ? sku.slice(sku.indexOf('-')+1) : sku; return TIER[s] || s; }
          var tiers = cat[firstLoc].plans.map(function(p,i){
            var from = Infinity; locKeys.forEach(function(k){ var pr = cat[k].plans[i].price; if (pr < from) from = pr; });
            return { i:i, name:tierName(p.name), cpu:p.cpu, proc:p.proc, ram:p.ram, disk:p.disk, bw:p.bw, up:p.up, gpu:p.gpu, vram:p.vram, pop:p.pop, from:from };
          });
          var defTier = (tiers.filter(function(t){return t.pop;})[0] || tiers[Math.min(2, tiers.length-1)]).i;
          var state = { tier:defTier, loc:firstLoc, months:1, stacks:new Set(), models:new Set() };
          if (isGpu) Object.keys(GPU.stacks).forEach(function(s){ if (GPU.stacks[s].def) state.stacks.add(s); });

          function money(n){ return '$' + (Math.round(n*100)/100).toFixed(2); }
          function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
          function planFor(loc,i){ return cat[loc].plans[i]; }
          function total(){ var p=planFor(state.loc,state.tier), d=disc[state.months]||0; return (p.price*(1-d/100))*state.months; }

          function specRows(t){
            if (type === 'gpu')        return [['GPU',t.gpu],['VRAM',t.vram],['CPU',t.cpu],['RAM',t.ram],['Disk',t.disk]];
            if (type === 'dedicated')  return [['CPU',t.cpu],['Model',t.proc],['RAM',t.ram],['Disk',t.disk],['Network',t.up]];
            if (type === 'rdp')        return [['CPU',t.cpu],['RAM',t.ram],['Disk',t.disk],['Bandwidth',t.bw+'/mo'],['Uplink',t.up]];
            return [['CPU',t.cpu],['RAM',t.ram],['Disk',t.disk],['Network',t.bw+' · '+t.up]];
          }

          function renderPlans(){
            plansEl.innerHTML = tiers.map(function(t){
              var rows = specRows(t).map(function(r){ return '<span class="vdp-row"><i>'+esc(r[0])+'</i><b>'+esc(r[1])+'</b></span>'; }).join('');
              return '<button type="button" class="vdp'+(t.i===state.tier?' on':'')+'" data-tier="'+t.i+'">'
                + '<span class="vdp-check" aria-hidden="true">✓</span>'
                + '<span class="vdp-top"><span class="vdp-name">'+esc(t.name)+'</span>'+(t.pop?'<span class="vdp-pop">'+T.popular+'</span>':'')+'</span>'
                + '<span class="vdp-specs">'+rows+'</span>'
                + '<span class="vdp-foot"><span class="vdp-price"><i>'+T.from+'</i> <b>'+money(t.from)+'</b><i>/mo</i></span></span>'
                + '</button>';
            }).join('');
          }
          function renderLocs(){
            locsEl.innerHTML = locKeys.map(function(k){
              var pr = planFor(k,state.tier).price;
              return '<button type="button" class="vdl'+(k===state.loc?' on':'')+'" data-loc="'+k+'">'
                + '<span class="fi fi-'+cat[k].flag+'"></span>'
                + '<span class="vdl-body"><span class="vdl-name">'+esc(cat[k].name)+'</span><span class="vdl-price"><b>'+money(pr)+'</b>/mo</span></span>'
                + '</button>';
            }).join('');
          }
          function recapText(t){
            if (type === 'gpu') return t.gpu + ' · ' + t.vram + ' · ' + t.cpu + ' · ' + t.ram;
            return t.cpu + ' · ' + t.ram + ' · ' + t.disk;
          }
          function renderRecap(){
            var t = tiers[state.tier];
            recapEl.innerHTML = '<div class="vdw-recap-l"><span class="vdw-recap-name">'+esc(t.name)+'</span><span class="vdw-recap-spec">'+esc(recapText(t))+'</span></div>'
              + '<button type="button" class="vdw-recap-ch" data-el="change">'+T.change+'</button>';
            recapEl.querySelector('[data-el="change"]').addEventListener('click', function(){ goStep(1); });
          }
          // Duree servie : lue sur le bouton, que PHP a rempli depuis
          // sp_promo_service_months(). Le navigateur n'a pas a savoir que le
          // facteur vaut 2 ni sur quelles gammes l'offre porte.
          function servedMonths(){
            var b=termsEl.querySelector('.vdw-term[data-m="'+state.months+'"]');
            var v=b?parseInt(b.dataset.served||'0',10):0;
            return v>0?v:state.months;
          }
          function moLabel(n){ return n===1 ? T.monthsOne : T.monthsFmt.replace('{n}',n); }
          function renderPromo(){
            var el=$('promoLive');
            if(!promoOn||!el) return;
            el.textContent=T.promoHint.replace('{paid}',moLabel(state.months))
                                      .replace('{total}',moLabel(servedMonths()));
          }

          function renderTotal(){
            var d=disc[state.months]||0, tot=total();
            var line='<b>'+money(tot)+'</b><i>'+T.forN.replace(':n',state.months)+'</i>';
            if (d>0) line+='<span class="vdw-save">−'+d+'%</span>';
            if (promoOn) line+='<span class="vdw-x2-tot">'+state.months+' → '+servedMonths()+'</span>';
            totalEl.innerHTML=line;
            renderPromo();
            if (bal+0.001>=tot){ btn.textContent=T.deploy+' · '+money(tot); btn.dataset.mode='deploy'; btn.classList.remove('bt-o'); btn.classList.add('bt-p'); }
            else { var def=Math.round((tot-bal)*100)/100; btn.textContent=T.topup+' '+money(def); btn.dataset.mode='topup'; btn.dataset.deficit=def; btn.classList.remove('bt-p'); btn.classList.add('bt-o'); }
            btn.disabled=false; msg.textContent='';
          }
          function goStep(n){
            panes.forEach(function(p){ p.classList.toggle('on', +p.dataset.step===n); });
            steps.forEach(function(s){ var i=+s.dataset.i; s.classList.toggle('on', i===n); s.classList.toggle('done', i<n); });
            if (n===2){ renderRecap(); renderLocs(); renderTotal(); if (isGpu) refreshGpu(); }
          }

          // ── GPU AI config ──
          var hfEl, shutEl, pubEl, recipesEl, stacksEl, modelsEl, aiSumEl, aiRegion, aiNoCuda, hfWarn;
          if (isGpu){
            hfEl=$('hf'); shutEl=$('shut'); pubEl=$('pub');
            recipesEl=$('recipes'); stacksEl=$('stacks'); modelsEl=$('models'); aiSumEl=$('aiSum');
            aiRegion=$('aiRegion'); aiNoCuda=$('aiNoCuda'); hfWarn=$('hfWarn');
          }
          function vram(){ return GPU.vramTiers[state.tier] || 0; }
          function osCuda(){ return GPU.cuda.indexOf(osSel.value) !== -1; }
          function gpuGate(){
            state.stacks.forEach(function(s){ if (!GPU.stacks[s].def && GPU.stacks[s].vram > vram()) state.stacks.delete(s); });
            state.models.forEach(function(m){ if ((GPU.models[m].vram||0) > vram()) state.models.delete(m); });
          }
          function renderRecipes(){
            recipesEl.innerHTML = GPU.recipes.map(function(r){
              var lock = r.minVram > vram();
              return '<button type="button" class="vdg-recipe'+(lock?' lock':'')+'" data-stacks="'+esc(r.stacks.join(','))+'" data-models="'+esc(r.models.join(','))+'"'+(lock?' disabled':'')+'>'
                + '<strong>'+esc(r.title)+'</strong><em>'+esc(r.sub)+'</em>'
                + (lock?'<span class="vdg-lock">'+T.needs.replace(':n',r.minVram)+'</span>':'')
                + '</button>';
            }).join('');
          }
          function chipHtml(kind, slug){
            var it = (kind==='stacks'?GPU.stacks:GPU.models)[slug];
            var sel = (kind==='stacks'?state.stacks:state.models).has(slug);
            var lock = (it.vram||0) > vram();
            var cls = 'vdg-chip'+(sel?' on':'')+(lock?' lock':'')+(it.def?' locked-on':'')+(it.gated?' gated':'');
            var meta = (it.size?('<small>'+it.size+'G</small>'):'') + (it.gated?'<span class="vdg-g">'+T.gated+'</span>':'') + (lock?'<span class="vdg-need">'+T.needs.replace(':n',it.vram)+'</span>':'');
            return '<button type="button" class="'+cls+'" data-kind="'+kind+'" data-slug="'+esc(slug)+'"'+((lock||it.def)?' disabled':'')+'>'+esc(it.name)+' '+meta+'</button>';
          }
          function renderChips(){
            var byCat = function(items, labels){
              var cats={}; Object.keys(items).forEach(function(s){ (cats[items[s].cat]=cats[items[s].cat]||[]).push(s); });
              return Object.keys(cats).map(function(c){
                return '<div class="vdg-cat"><span class="vdg-cat-h">'+esc(labels[c]||c)+'</span>'+cats[c].map(function(s){return chipHtml(items===GPU.stacks?'stacks':'models', s);}).join('')+'</div>';
              }).join('');
            };
            stacksEl.innerHTML = byCat(GPU.stacks, GPU.stackCats);
            modelsEl.innerHTML = byCat(GPU.models, GPU.modelCats);
          }
          function aiSummary(){
            var names=[];
            state.stacks.forEach(function(s){ names.push(GPU.stacks[s].name); });
            state.models.forEach(function(m){ names.push(GPU.models[m].name); });
            aiSumEl.textContent = names.length ? ('✓ ' + names.join(' · ')) : T.none;
          }
          function hfWarnUpd(){
            var need=false; state.models.forEach(function(m){ if (GPU.models[m].gated) need=true; });
            hfWarn.hidden = !(need && !hfEl.value.trim());
          }
          function refreshGpu(){
            var cuda = osCuda();
            aiNoCuda.hidden = cuda; aiRegion.hidden = !cuda;
            gpuGate(); renderRecipes(); renderChips(); aiSummary(); hfWarnUpd();
          }

          // ── events ──
          plansEl.addEventListener('click', function(e){ var c=e.target.closest('.vdp'); if(!c)return; state.tier=+c.dataset.tier; renderPlans(); goStep(2); });
          locsEl.addEventListener('click', function(e){ var c=e.target.closest('.vdl'); if(!c)return; state.loc=c.dataset.loc; renderLocs(); renderTotal(); });
          termsEl.addEventListener('click', function(e){ var c=e.target.closest('.vdw-term'); if(!c)return; state.months=+c.dataset.m; termsEl.querySelectorAll('.vdw-term').forEach(function(b){b.classList.toggle('on',b===c);}); renderTotal(); });
          osSel.addEventListener('change', function(){ renderTotal(); if (isGpu) refreshGpu(); });
          backEl.addEventListener('click', function(){ goStep(1); });
          steps.forEach(function(s){ s.addEventListener('click', function(){ goStep(+s.dataset.i); }); });
          function genPassword(){ var c='ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@#$%*-_', n=18, out='', a=new Uint32Array(n); (window.crypto||window.msCrypto).getRandomValues(a); for (var i=0;i<n;i++) out+=c.charAt(a[i]%c.length); return out; }
          if (genpwEl) genpwEl.addEventListener('click', function(){ pwEl.value=genPassword(); pwEl.focus(); pwEl.select(); });

          if (isGpu){
            recipesEl.addEventListener('click', function(e){
              var c=e.target.closest('.vdg-recipe'); if(!c||c.disabled)return;
              state.stacks=new Set(); Object.keys(GPU.stacks).forEach(function(s){ if (GPU.stacks[s].def) state.stacks.add(s); });
              state.models=new Set();
              (c.dataset.stacks?c.dataset.stacks.split(','):[]).forEach(function(s){ state.stacks.add(s); });
              (c.dataset.models?c.dataset.models.split(','):[]).forEach(function(s){ state.models.add(s); });
              refreshGpu();
            });
            function chipClick(e){
              var c=e.target.closest('.vdg-chip'); if(!c||c.disabled)return;
              var set = c.dataset.kind==='stacks'?state.stacks:state.models;
              if (set.has(c.dataset.slug)) set.delete(c.dataset.slug); else set.add(c.dataset.slug);
              renderChips(); aiSummary(); hfWarnUpd();
            }
            stacksEl.addEventListener('click', chipClick);
            modelsEl.addEventListener('click', chipClick);
            hfEl.addEventListener('input', hfWarnUpd);
          }

          btn.addEventListener('click', function(){
            if (btn.dataset.mode==='topup'){ window.location.href='?tab=topup&need='+(btn.dataset.deficit||''); return; }
            var p=planFor(state.loc,state.tier); if(!p)return;
            if (isGpu && (!pwEl.value || pwEl.value.length<8)){ msg.textContent=T.pwReq; pwEl.focus(); return; }
            var prev=btn.textContent; btn.disabled=true; btn.textContent=T.working; msg.textContent='';
            var fd=new FormData();
            fd.append('action','create'); fd.append('type',type); fd.append('plan',p.name);
            fd.append('location',state.loc); fd.append('os',osSel.value); fd.append('billing',state.months); fd.append('_token',csrf);
            if (pwEl.value) fd.append('password',pwEl.value);
            if (isGpu){
              fd.append('auto_shutdown_hours',shutEl.value);
              if (osCuda()){
                state.stacks.forEach(function(s){ fd.append('ai_stacks[]',s); });
                state.models.forEach(function(m){ fd.append('pretrained_models[]',m); });
                if (hfEl.value.trim()) fd.append('hf_token',hfEl.value.trim());
                if (pubEl.checked) fd.append('public_endpoint','1');
              }
            }
            fetch('/pay-api.php',{method:'POST',body:fd,headers:{'X-CSRF-TOKEN':csrf}})
              .then(function(r){return r.json();})
              .then(function(d){
                if (d && d.ok && d.redirect){ window.location.href=d.redirect; return; }
                if (d && d.insufficient && d.redirect){ window.location.href=d.redirect; return; }
                msg.textContent=(d&&d.error)?d.error:T.genErr; btn.disabled=false; btn.textContent=prev;
              })
              .catch(function(){ msg.textContent=T.netErr; btn.disabled=false; btn.textContent=prev; });
          });

          renderPlans();
        })();
        </script>

              </div>
            <div class="dash-tab" data-pane="rdp">
        <header class="dash-h">
          <h2>Windows RDP <span class="dash-h-cnt">0</span></h2>
          <p>具备管理员权限的 Windows Server / Win11 会话，共享主机。</p>
          <div class="dash-h-r">
            <a href="/zh/rdp" class="bt bt-p bt-sm">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 3v10M3 8h10"/></svg>
              订购新 RDP            </a>
          </div>
        </header>

                <section class="vdw" id="vdw-rdp" data-type="rdp">
          <div class="vdw-head">
            <div class="vdw-head-l">
              <h3>部署新的 RDP 服务器</h3>
              <p>选择套餐和位置——从余额扣款，几分钟内就绪。</p>
            </div>
          </div>

          
          <div class="vdw-steps">
            <button type="button" class="vdw-step on" data-i="1"><span class="vdw-num">1</span><span class="vdw-lbl">选择套餐</span></button>
            <span class="vdw-sep"></span>
            <button type="button" class="vdw-step" data-i="2"><span class="vdw-num">2</span><span class="vdw-lbl">位置与选项</span></button>
          </div>

          <div class="vdw-pane on" data-step="1">
            <div class="vdw-plans" data-el="plans"></div>
          </div>

          <div class="vdw-pane" data-step="2">
            <div class="vdw-recap" data-el="recap"></div>

            <div class="vdw-lab">地区</div>
            <div class="vdw-locs" data-el="locs"></div>

            <div class="vdw-opts">
              <label class="vdw-f">
                <span>操作系统</span>
                <select data-el="os">
                                    <optgroup label="Windows Server">
                                        <option value="win-2022" selected>Windows Server 2022 Standard</option>
                                        <option value="win-2025">Windows Server 2025 Standard</option>
                                        <option value="win-2019">Windows Server 2019 Standard</option>
                                      </optgroup>
                                    <optgroup label="Windows Desktop">
                                        <option value="win-11">Windows 11 Pro</option>
                                      </optgroup>
                                  </select>
              </label>
              <div class="vdw-f">
                <span>计费周期</span>
                <div class="vdw-terms" data-el="terms">
                                    <button type="button" class="vdw-term on" data-m="1" data-served="1">1 个月</button>
                  <button type="button" class="vdw-term" data-m="3" data-served="3">3 个月<em>&minus;25%</em></button>
                  <button type="button" class="vdw-term" data-m="6" data-served="6">6 个月<em>&minus;35%</em></button>
                  <button type="button" class="vdw-term" data-m="12" data-served="12">12 个月<em>&minus;50%</em></button>
                </div>
                              </div>
            </div>

            <div class="vdw-creds">
              <div class="vdw-lab">登录名与密码</div>
              <div class="vdw-cred-row">
                <div class="vdw-cred-user"><span>用户名</span><b>Administrator</b></div>
                <div class="vdw-cred-pw">
                  <input type="text" data-el="pw" class="vdw-input" autocomplete="off" spellcheck="false" placeholder="设置或生成密码">
                  <button type="button" class="bt bt-o bt-sm" data-el="genpw">生成</button>
                </div>
              </div>
              <p class="vdw-hint">可选——生成一个强 root 密码并立即复制。</p>
            </div>

            
            <div class="vdw-foot">
              <button type="button" class="bt bt-o bt-sm vdw-back" data-el="back">&larr; 返回</button>
              <div class="vdw-total" data-el="total"></div>
              <div class="vdw-act">
                <span class="vdw-msg" data-el="msg"></span>
                <button type="button" class="bt bt-p" data-el="btn">部署</button>
              </div>
            </div>
          </div>
        </section>

        <script>
        (function(){
          var type = "rdp";
          var cat  = {"moldova":{"name":"Moldova","flag":"md","plans":[{"name":"MD-S","price":11,"cpu":"2 vCPU","proc":"AMD Ryzen 7 5800X (4.7 GHz)","ram":"4 GB DDR4","disk":"60 GB NVMe","bw":"2 TB","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"MD-M","price":16,"cpu":"4 vCPU","proc":"AMD Ryzen 7 5800X (4.7 GHz)","ram":"8 GB DDR4","disk":"120 GB NVMe","bw":"5 TB","up":"1 Gbps","gpu":"","vram":"","pop":true},{"name":"MD-L","price":22,"cpu":"6 vCPU","proc":"AMD Ryzen 7 5800X (4.7 GHz)","ram":"16 GB DDR4","disk":"200 GB NVMe","bw":"10 TB","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"MD-XL","price":32,"cpu":"8 vCPU","proc":"AMD Ryzen 7 7700X (5.4 GHz)","ram":"32 GB DDR5","disk":"400 GB NVMe","bw":"20 TB","up":"2 Gbps","gpu":"","vram":"","pop":false}]},"romania":{"name":"Romania","flag":"ro","plans":[{"name":"RO-S","price":12,"cpu":"2 vCPU","proc":"AMD Ryzen 9 5900X (4.8 GHz)","ram":"4 GB DDR4","disk":"60 GB NVMe","bw":"2 TB","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"RO-M","price":17.5,"cpu":"4 vCPU","proc":"AMD Ryzen 9 5900X (4.8 GHz)","ram":"8 GB DDR4","disk":"120 GB NVMe","bw":"5 TB","up":"1 Gbps","gpu":"","vram":"","pop":true},{"name":"RO-L","price":24.5,"cpu":"6 vCPU","proc":"AMD Ryzen 9 5900X (4.8 GHz)","ram":"16 GB DDR4","disk":"200 GB NVMe","bw":"10 TB","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"RO-XL","price":34.5,"cpu":"8 vCPU","proc":"AMD Ryzen 9 7900X (5.6 GHz)","ram":"32 GB DDR5","disk":"400 GB NVMe","bw":"20 TB","up":"2 Gbps","gpu":"","vram":"","pop":false}]},"netherlands":{"name":"Netherlands","flag":"nl","plans":[{"name":"NL-S","price":12,"cpu":"2 vCPU","proc":"Intel Core i9-12900K (5.2 GHz)","ram":"4 GB DDR4","disk":"60 GB NVMe","bw":"2 TB","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"NL-M","price":18.5,"cpu":"4 vCPU","proc":"Intel Core i9-12900K (5.2 GHz)","ram":"8 GB DDR4","disk":"120 GB NVMe","bw":"5 TB","up":"1 Gbps","gpu":"","vram":"","pop":true},{"name":"NL-L","price":26,"cpu":"6 vCPU","proc":"Intel Core i9-12900K (5.2 GHz)","ram":"16 GB DDR4","disk":"200 GB NVMe","bw":"10 TB","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"NL-XL","price":36.5,"cpu":"8 vCPU","proc":"AMD Ryzen 9 7950X (5.7 GHz)","ram":"32 GB DDR5","disk":"400 GB NVMe","bw":"20 TB","up":"2 Gbps","gpu":"","vram":"","pop":false}]},"russia":{"name":"Russia","flag":"ru","plans":[{"name":"RU-S","price":11,"cpu":"2 vCPU","proc":"AMD Ryzen 7 5800X (4.7 GHz)","ram":"4 GB DDR4","disk":"60 GB NVMe","bw":"2 TB","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"RU-M","price":16,"cpu":"4 vCPU","proc":"AMD Ryzen 7 5800X (4.7 GHz)","ram":"8 GB DDR4","disk":"120 GB NVMe","bw":"5 TB","up":"1 Gbps","gpu":"","vram":"","pop":true},{"name":"RU-L","price":22,"cpu":"6 vCPU","proc":"AMD Ryzen 7 5800X (4.7 GHz)","ram":"16 GB DDR4","disk":"200 GB NVMe","bw":"10 TB","up":"1 Gbps","gpu":"","vram":"","pop":false},{"name":"RU-XL","price":32,"cpu":"8 vCPU","proc":"AMD Ryzen 7 7700X (5.4 GHz)","ram":"32 GB DDR5","disk":"400 GB NVMe","bw":"20 TB","up":"2 Gbps","gpu":"","vram":"","pop":false}]}};
          var disc = {1:0, 3:25, 6:35, 12:50};
          var bal  = 0;
          var csrf = "c03e45df8e27a9266fd185c09a1efb2bdd5497765a4b14b1c2ce20cceeb687bf";
          var isGpu = false;
          var GPU = null;
          var TIER = {S:"\u5c0f\u578b",M:"\u4e2d\u578b",L:"\u5927\u578b",XL:"\u8d85\u5927\u578b",XXL:"\u5de8\u578b",PRO:"Pro",'1':"\u5c0f\u578b",'2':"\u4e2d\u578b",'3':"\u5927\u578b",'4':"\u8d85\u5927\u578b"};
          var T = {
            popular:"\u70ed\u95e8", from:"\u8d77", change:"\u66f4\u6539",
            deploy:"\u90e8\u7f72", topup:"\u7acb\u5373\u5145\u503c", working:"\u6b63\u5728\u90e8\u7f72\u2026",
            forN:"\u5171 :n \u4e2a\u6708", netErr:"\u7f51\u7edc\u9519\u8bef\u3002", genErr:"\u90e8\u7f72\u5931\u8d25\uff0c\u8bf7\u91cd\u8bd5\u3002",
            needs:"\u9700\u8981 :n GB", gated:"\u53d7\u9650", pwReq:"\u8bf7\u8bbe\u7f6e root \u5bc6\u7801\uff08\u81f3\u5c11 8 \u4e2a\u5b57\u7b26\uff09\u3002", none:"\u65e0 AI \u6a21\u677f\u2014\u2014\u7eaf CUDA \u673a\u5668\u3002",
            // Deux gabarits : PHP remplace :n par {n}, le JS substitue ensuite.
            // La forme singuliere est distincte, sinon "+1 Months" en anglais.
            monthsOne:"1 \u4e2a\u6708",
            monthsFmt:"{n} \u4e2a\u6708",
            promoHint:"\u60a8\u652f\u4ed8 {paid}\uff0c\u670d\u52a1\u5668\u8fd0\u884c {total}\u3002"          };
          var promoOn = false;

          var root = document.getElementById('vdw-' + type);
          if (!root) return;
          var $ = function(n){ return root.querySelector('[data-el="' + n + '"]'); };
          var plansEl=$('plans'), locsEl=$('locs'), recapEl=$('recap'), osSel=$('os'), termsEl=$('terms'),
              totalEl=$('total'), btn=$('btn'), msg=$('msg'), backEl=$('back'), pwEl=$('pw'), genpwEl=$('genpw');
          var panes = [].slice.call(root.querySelectorAll('.vdw-pane'));
          var steps = [].slice.call(root.querySelectorAll('.vdw-step'));

          var locKeys = Object.keys(cat), firstLoc = locKeys[0];
          function tierName(sku){ var s = sku.indexOf('-')>=0 ? sku.slice(sku.indexOf('-')+1) : sku; return TIER[s] || s; }
          var tiers = cat[firstLoc].plans.map(function(p,i){
            var from = Infinity; locKeys.forEach(function(k){ var pr = cat[k].plans[i].price; if (pr < from) from = pr; });
            return { i:i, name:tierName(p.name), cpu:p.cpu, proc:p.proc, ram:p.ram, disk:p.disk, bw:p.bw, up:p.up, gpu:p.gpu, vram:p.vram, pop:p.pop, from:from };
          });
          var defTier = (tiers.filter(function(t){return t.pop;})[0] || tiers[Math.min(2, tiers.length-1)]).i;
          var state = { tier:defTier, loc:firstLoc, months:1, stacks:new Set(), models:new Set() };
          if (isGpu) Object.keys(GPU.stacks).forEach(function(s){ if (GPU.stacks[s].def) state.stacks.add(s); });

          function money(n){ return '$' + (Math.round(n*100)/100).toFixed(2); }
          function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
          function planFor(loc,i){ return cat[loc].plans[i]; }
          function total(){ var p=planFor(state.loc,state.tier), d=disc[state.months]||0; return (p.price*(1-d/100))*state.months; }

          function specRows(t){
            if (type === 'gpu')        return [['GPU',t.gpu],['VRAM',t.vram],['CPU',t.cpu],['RAM',t.ram],['Disk',t.disk]];
            if (type === 'dedicated')  return [['CPU',t.cpu],['Model',t.proc],['RAM',t.ram],['Disk',t.disk],['Network',t.up]];
            if (type === 'rdp')        return [['CPU',t.cpu],['RAM',t.ram],['Disk',t.disk],['Bandwidth',t.bw+'/mo'],['Uplink',t.up]];
            return [['CPU',t.cpu],['RAM',t.ram],['Disk',t.disk],['Network',t.bw+' · '+t.up]];
          }

          function renderPlans(){
            plansEl.innerHTML = tiers.map(function(t){
              var rows = specRows(t).map(function(r){ return '<span class="vdp-row"><i>'+esc(r[0])+'</i><b>'+esc(r[1])+'</b></span>'; }).join('');
              return '<button type="button" class="vdp'+(t.i===state.tier?' on':'')+'" data-tier="'+t.i+'">'
                + '<span class="vdp-check" aria-hidden="true">✓</span>'
                + '<span class="vdp-top"><span class="vdp-name">'+esc(t.name)+'</span>'+(t.pop?'<span class="vdp-pop">'+T.popular+'</span>':'')+'</span>'
                + '<span class="vdp-specs">'+rows+'</span>'
                + '<span class="vdp-foot"><span class="vdp-price"><i>'+T.from+'</i> <b>'+money(t.from)+'</b><i>/mo</i></span></span>'
                + '</button>';
            }).join('');
          }
          function renderLocs(){
            locsEl.innerHTML = locKeys.map(function(k){
              var pr = planFor(k,state.tier).price;
              return '<button type="button" class="vdl'+(k===state.loc?' on':'')+'" data-loc="'+k+'">'
                + '<span class="fi fi-'+cat[k].flag+'"></span>'
                + '<span class="vdl-body"><span class="vdl-name">'+esc(cat[k].name)+'</span><span class="vdl-price"><b>'+money(pr)+'</b>/mo</span></span>'
                + '</button>';
            }).join('');
          }
          function recapText(t){
            if (type === 'gpu') return t.gpu + ' · ' + t.vram + ' · ' + t.cpu + ' · ' + t.ram;
            return t.cpu + ' · ' + t.ram + ' · ' + t.disk;
          }
          function renderRecap(){
            var t = tiers[state.tier];
            recapEl.innerHTML = '<div class="vdw-recap-l"><span class="vdw-recap-name">'+esc(t.name)+'</span><span class="vdw-recap-spec">'+esc(recapText(t))+'</span></div>'
              + '<button type="button" class="vdw-recap-ch" data-el="change">'+T.change+'</button>';
            recapEl.querySelector('[data-el="change"]').addEventListener('click', function(){ goStep(1); });
          }
          // Duree servie : lue sur le bouton, que PHP a rempli depuis
          // sp_promo_service_months(). Le navigateur n'a pas a savoir que le
          // facteur vaut 2 ni sur quelles gammes l'offre porte.
          function servedMonths(){
            var b=termsEl.querySelector('.vdw-term[data-m="'+state.months+'"]');
            var v=b?parseInt(b.dataset.served||'0',10):0;
            return v>0?v:state.months;
          }
          function moLabel(n){ return n===1 ? T.monthsOne : T.monthsFmt.replace('{n}',n); }
          function renderPromo(){
            var el=$('promoLive');
            if(!promoOn||!el) return;
            el.textContent=T.promoHint.replace('{paid}',moLabel(state.months))
                                      .replace('{total}',moLabel(servedMonths()));
          }

          function renderTotal(){
            var d=disc[state.months]||0, tot=total();
            var line='<b>'+money(tot)+'</b><i>'+T.forN.replace(':n',state.months)+'</i>';
            if (d>0) line+='<span class="vdw-save">−'+d+'%</span>';
            if (promoOn) line+='<span class="vdw-x2-tot">'+state.months+' → '+servedMonths()+'</span>';
            totalEl.innerHTML=line;
            renderPromo();
            if (bal+0.001>=tot){ btn.textContent=T.deploy+' · '+money(tot); btn.dataset.mode='deploy'; btn.classList.remove('bt-o'); btn.classList.add('bt-p'); }
            else { var def=Math.round((tot-bal)*100)/100; btn.textContent=T.topup+' '+money(def); btn.dataset.mode='topup'; btn.dataset.deficit=def; btn.classList.remove('bt-p'); btn.classList.add('bt-o'); }
            btn.disabled=false; msg.textContent='';
          }
          function goStep(n){
            panes.forEach(function(p){ p.classList.toggle('on', +p.dataset.step===n); });
            steps.forEach(function(s){ var i=+s.dataset.i; s.classList.toggle('on', i===n); s.classList.toggle('done', i<n); });
            if (n===2){ renderRecap(); renderLocs(); renderTotal(); if (isGpu) refreshGpu(); }
          }

          // ── GPU AI config ──
          var hfEl, shutEl, pubEl, recipesEl, stacksEl, modelsEl, aiSumEl, aiRegion, aiNoCuda, hfWarn;
          if (isGpu){
            hfEl=$('hf'); shutEl=$('shut'); pubEl=$('pub');
            recipesEl=$('recipes'); stacksEl=$('stacks'); modelsEl=$('models'); aiSumEl=$('aiSum');
            aiRegion=$('aiRegion'); aiNoCuda=$('aiNoCuda'); hfWarn=$('hfWarn');
          }
          function vram(){ return GPU.vramTiers[state.tier] || 0; }
          function osCuda(){ return GPU.cuda.indexOf(osSel.value) !== -1; }
          function gpuGate(){
            state.stacks.forEach(function(s){ if (!GPU.stacks[s].def && GPU.stacks[s].vram > vram()) state.stacks.delete(s); });
            state.models.forEach(function(m){ if ((GPU.models[m].vram||0) > vram()) state.models.delete(m); });
          }
          function renderRecipes(){
            recipesEl.innerHTML = GPU.recipes.map(function(r){
              var lock = r.minVram > vram();
              return '<button type="button" class="vdg-recipe'+(lock?' lock':'')+'" data-stacks="'+esc(r.stacks.join(','))+'" data-models="'+esc(r.models.join(','))+'"'+(lock?' disabled':'')+'>'
                + '<strong>'+esc(r.title)+'</strong><em>'+esc(r.sub)+'</em>'
                + (lock?'<span class="vdg-lock">'+T.needs.replace(':n',r.minVram)+'</span>':'')
                + '</button>';
            }).join('');
          }
          function chipHtml(kind, slug){
            var it = (kind==='stacks'?GPU.stacks:GPU.models)[slug];
            var sel = (kind==='stacks'?state.stacks:state.models).has(slug);
            var lock = (it.vram||0) > vram();
            var cls = 'vdg-chip'+(sel?' on':'')+(lock?' lock':'')+(it.def?' locked-on':'')+(it.gated?' gated':'');
            var meta = (it.size?('<small>'+it.size+'G</small>'):'') + (it.gated?'<span class="vdg-g">'+T.gated+'</span>':'') + (lock?'<span class="vdg-need">'+T.needs.replace(':n',it.vram)+'</span>':'');
            return '<button type="button" class="'+cls+'" data-kind="'+kind+'" data-slug="'+esc(slug)+'"'+((lock||it.def)?' disabled':'')+'>'+esc(it.name)+' '+meta+'</button>';
          }
          function renderChips(){
            var byCat = function(items, labels){
              var cats={}; Object.keys(items).forEach(function(s){ (cats[items[s].cat]=cats[items[s].cat]||[]).push(s); });
              return Object.keys(cats).map(function(c){
                return '<div class="vdg-cat"><span class="vdg-cat-h">'+esc(labels[c]||c)+'</span>'+cats[c].map(function(s){return chipHtml(items===GPU.stacks?'stacks':'models', s);}).join('')+'</div>';
              }).join('');
            };
            stacksEl.innerHTML = byCat(GPU.stacks, GPU.stackCats);
            modelsEl.innerHTML = byCat(GPU.models, GPU.modelCats);
          }
          function aiSummary(){
            var names=[];
            state.stacks.forEach(function(s){ names.push(GPU.stacks[s].name); });
            state.models.forEach(function(m){ names.push(GPU.models[m].name); });
            aiSumEl.textContent = names.length ? ('✓ ' + names.join(' · ')) : T.none;
          }
          function hfWarnUpd(){
            var need=false; state.models.forEach(function(m){ if (GPU.models[m].gated) need=true; });
            hfWarn.hidden = !(need && !hfEl.value.trim());
          }
          function refreshGpu(){
            var cuda = osCuda();
            aiNoCuda.hidden = cuda; aiRegion.hidden = !cuda;
            gpuGate(); renderRecipes(); renderChips(); aiSummary(); hfWarnUpd();
          }

          // ── events ──
          plansEl.addEventListener('click', function(e){ var c=e.target.closest('.vdp'); if(!c)return; state.tier=+c.dataset.tier; renderPlans(); goStep(2); });
          locsEl.addEventListener('click', function(e){ var c=e.target.closest('.vdl'); if(!c)return; state.loc=c.dataset.loc; renderLocs(); renderTotal(); });
          termsEl.addEventListener('click', function(e){ var c=e.target.closest('.vdw-term'); if(!c)return; state.months=+c.dataset.m; termsEl.querySelectorAll('.vdw-term').forEach(function(b){b.classList.toggle('on',b===c);}); renderTotal(); });
          osSel.addEventListener('change', function(){ renderTotal(); if (isGpu) refreshGpu(); });
          backEl.addEventListener('click', function(){ goStep(1); });
          steps.forEach(function(s){ s.addEventListener('click', function(){ goStep(+s.dataset.i); }); });
          function genPassword(){ var c='ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@#$%*-_', n=18, out='', a=new Uint32Array(n); (window.crypto||window.msCrypto).getRandomValues(a); for (var i=0;i<n;i++) out+=c.charAt(a[i]%c.length); return out; }
          if (genpwEl) genpwEl.addEventListener('click', function(){ pwEl.value=genPassword(); pwEl.focus(); pwEl.select(); });

          if (isGpu){
            recipesEl.addEventListener('click', function(e){
              var c=e.target.closest('.vdg-recipe'); if(!c||c.disabled)return;
              state.stacks=new Set(); Object.keys(GPU.stacks).forEach(function(s){ if (GPU.stacks[s].def) state.stacks.add(s); });
              state.models=new Set();
              (c.dataset.stacks?c.dataset.stacks.split(','):[]).forEach(function(s){ state.stacks.add(s); });
              (c.dataset.models?c.dataset.models.split(','):[]).forEach(function(s){ state.models.add(s); });
              refreshGpu();
            });
            function chipClick(e){
              var c=e.target.closest('.vdg-chip'); if(!c||c.disabled)return;
              var set = c.dataset.kind==='stacks'?state.stacks:state.models;
              if (set.has(c.dataset.slug)) set.delete(c.dataset.slug); else set.add(c.dataset.slug);
              renderChips(); aiSummary(); hfWarnUpd();
            }
            stacksEl.addEventListener('click', chipClick);
            modelsEl.addEventListener('click', chipClick);
            hfEl.addEventListener('input', hfWarnUpd);
          }

          btn.addEventListener('click', function(){
            if (btn.dataset.mode==='topup'){ window.location.href='?tab=topup&need='+(btn.dataset.deficit||''); return; }
            var p=planFor(state.loc,state.tier); if(!p)return;
            if (isGpu && (!pwEl.value || pwEl.value.length<8)){ msg.textContent=T.pwReq; pwEl.focus(); return; }
            var prev=btn.textContent; btn.disabled=true; btn.textContent=T.working; msg.textContent='';
            var fd=new FormData();
            fd.append('action','create'); fd.append('type',type); fd.append('plan',p.name);
            fd.append('location',state.loc); fd.append('os',osSel.value); fd.append('billing',state.months); fd.append('_token',csrf);
            if (pwEl.value) fd.append('password',pwEl.value);
            if (isGpu){
              fd.append('auto_shutdown_hours',shutEl.value);
              if (osCuda()){
                state.stacks.forEach(function(s){ fd.append('ai_stacks[]',s); });
                state.models.forEach(function(m){ fd.append('pretrained_models[]',m); });
                if (hfEl.value.trim()) fd.append('hf_token',hfEl.value.trim());
                if (pubEl.checked) fd.append('public_endpoint','1');
              }
            }
            fetch('/pay-api.php',{method:'POST',body:fd,headers:{'X-CSRF-TOKEN':csrf}})
              .then(function(r){return r.json();})
              .then(function(d){
                if (d && d.ok && d.redirect){ window.location.href=d.redirect; return; }
                if (d && d.insufficient && d.redirect){ window.location.href=d.redirect; return; }
                msg.textContent=(d&&d.error)?d.error:T.genErr; btn.disabled=false; btn.textContent=prev;
              })
              .catch(function(){ msg.textContent=T.netErr; btn.disabled=false; btn.textContent=prev; });
          });

          renderPlans();
        })();
        </script>

              </div>
            <div class="dash-tab" data-pane="gpu">
        <header class="dash-h">
          <h2>GPU Compute <span class="dash-h-cnt">0</span></h2>
          <p>NVIDIA RTX 4090 / 5090 / H100 — AI 训练与推理。</p>
