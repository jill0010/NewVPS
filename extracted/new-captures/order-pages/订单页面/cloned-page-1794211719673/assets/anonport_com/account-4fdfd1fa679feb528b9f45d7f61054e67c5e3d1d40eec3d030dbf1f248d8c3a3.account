<script>
// ── UX mobile : trois enrichissements progressifs, sans dependance ──────
(function(){
  // 1) Tableaux → cartes. Le <thead> est deja traduit dans la bonne langue :
  //    on recopie son texte dans data-th, la couche CSS "app mobile" fait le
  //    reste sous 600px. Sans JS : scroll horizontal d'origine.
  document.querySelectorAll('.tw > table.tb').forEach(function(tb){
    var ths=tb.querySelectorAll('thead th');
    if(!ths.length) return;
    var labels=[].map.call(ths,function(th){return th.textContent.trim()});
    tb.querySelectorAll('tbody tr').forEach(function(tr){
      [].forEach.call(tr.children,function(td,i){
        if(labels[i]) td.setAttribute('data-th',labels[i]);
        // Valeur longue (description, texte libre) : affichee sous l'etiquette.
        if(td.textContent.trim().length>34 && !td.querySelector('.bt,.cpu-cell')) td.classList.add('tb-wrapv');
      });
    });
    tb.classList.add('tb-cardify');
    var tw=tb.closest('.tw'); if(tw) tw.classList.add('tw-cards');
  });

  // 2) Indice de defilement sur ce qui reste en scroll horizontal
  //    (tableaux de guides, comparatifs) : voile sur le bord tant qu'il
  //    reste du contenu cache de ce cote.
  var scrollers=document.querySelectorAll('.tw:not(.tw-cards), .g-tbl-wrap, .cmp-wrap');
  [].forEach.call(scrollers,function(el){
    var out=document.createElement('div');
    out.className='hscroll-wrap';
    el.parentNode.insertBefore(out,el);
    out.appendChild(el);
    var L=document.createElement('div');L.className='hs-l';
    var R=document.createElement('div');R.className='hs-r';
    out.appendChild(L);out.appendChild(R);
    function upd(){
      var can=el.scrollWidth>el.clientWidth+2;
      out.classList.toggle('can-l',can&&el.scrollLeft>4);
      out.classList.toggle('can-r',can&&el.scrollLeft<el.scrollWidth-el.clientWidth-4);
    }
    el.addEventListener('scroll',upd,{passive:true});
    window.addEventListener('resize',upd);
    upd();
  });

  // 3) Ombre du header sticky des que la page defile.
  var hd=document.querySelector('.hd');
  if(hd){
    var t=false;
    function onScroll(){
      if(t) return; t=true;
      requestAnimationFrame(function(){
        hd.classList.toggle('is-scrolled',window.scrollY>4);
        t=false;
      });
    }
    window.addEventListener('scroll',onScroll,{passive:true});
    onScroll();
  }
})();

// Close lang menu on click outside
document.addEventListener('click',function(e){
  var sw=document.getElementById('langSw');
  if(sw&&!sw.contains(e.target)){document.getElementById('langMenu').classList.remove('open')}
});
</script>
<script>
// Deux rythmes differents. network-beacon (presence/attribution) part des que le
// thread principal est libre apres le load : chaque visite doit compter.
// rrweb + replay-beacon pesent 270 Ko et ne servent qu'a rejouer une session :
// une visite sans la moindre interaction n'a rien a rejouer, donc ils attendent
// la premiere entree reelle de l'utilisateur (filet de securite a 60 s).
(function(){
  function load(u, cb){ var s=document.createElement('script'); s.src=u; s.async=false;
    s.onload=s.onerror=function(){ cb && cb(); }; document.head.appendChild(s); }
  function idle(fn){ ('requestIdleCallback' in window) ? requestIdleCallback(fn,{timeout:2000}) : setTimeout(fn,600); }
  function onLoad(fn){ (document.readyState==='complete') ? fn() : window.addEventListener('load',fn); }

  onLoad(function(){ idle(function(){ load("\/assets\/network-beacon.js?v=1794172048"); }); });

  var armed=true, timer=null, EV=['pointerdown','keydown','touchstart','wheel','mousemove'];
  function replay(){
    if(!armed) return; armed=false;
    if(timer) clearTimeout(timer);
    EV.forEach(function(e){ window.removeEventListener(e, replay, {capture:true}); });
    load("\/assets\/rrweb.umd.min.js?v=1785429502", function(){
      load("\/assets\/replay-beacon.js?v=1794172048");
    });
  }
  onLoad(function(){
    EV.forEach(function(e){ window.addEventListener(e, replay, {passive:true, capture:true}); });
    timer=setTimeout(replay, 60000);
  });
})();
</script>
</body></html>
